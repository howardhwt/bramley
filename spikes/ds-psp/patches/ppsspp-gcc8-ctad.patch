--- a/Common/Thread/Promise.h
+++ b/Common/Thread/Promise.h
@@ -23,6 +23,13 @@ class IndependentTask : public Task {
 	TaskPriority prio_;
 };
 
+// Spike (tg5040): GCC 8.3 cannot deduce IndependentTask's argument from a lambda with move-only
+// captures, so callers in the libretro build use this helper instead of class template deduction.
+template<class T>
+IndependentTask<T> *NewIndependentTask(TaskType type, TaskPriority prio, T func) {
+	return new IndependentTask<T>(type, prio, std::move(func));
+}

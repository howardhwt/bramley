+    if (stylus_visible_binding() && same(stylus_button_[sl]) &&
+        ((stylus_down_ & bit) || (down && !pad_mod_down_ && (stylus_chord_down_ || !shares_ds_button(stylus_button_[sl]))))) {
       if (down) { stylus_down_ |= bit; touched_ = true; } else stylus_down_ &= static_cast<u8>(~bit);
       return true;
     }

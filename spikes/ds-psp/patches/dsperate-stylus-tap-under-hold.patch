   }
   // Tap button and d-pad chord yield to the pad modifier: mod+<tap button>
   // can be a hotkey. A release always ends an in-progress tap or chord.
+  // Bramley spike: a tap control that is also a DS button's binding (pad.a = b
+  // with pad.stylus_button = b) touches only while stylus_hold is held, and is
+  // the game's button otherwise. So R2 + A taps and A alone is still A.
+  auto shares_ds_button = [&](const Bind& t) {
+    for (int i = 0; i < static_cast<int>(B::BTN_COUNT); ++i)
+      if (pad_map_[i].kind == t.kind && pad_map_[i].code == t.code && (t.kind != Bind::PadAxis || pad_map_[i].neg == t.neg)) return true;
